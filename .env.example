# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/sequan
SPRING_DATASOURCE_USERNAME=sequan
SPRING_DATASOURCE_PASSWORD=sequan

# JWT (use a long random secret in production)
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Stripe: test-mode keys from https://dashboard.stripe.com/test/apikeys
# Webhook secret is printed by: stripe listen --forward-to localhost:8080/api/webhooks/stripe
# Prefer restricted keys (rk_) in production
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# App URLs
APP_BASE_URL=http://localhost:4200
APP_API_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:4200
